# Postgres connection string (compose.yml publishes its Postgres on 5433)
DATABASE_URL=postgres://bom:bom@localhost:5433/bom

# BetterAuth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Set to true to turn off self-registration (the /sign-up page and the
# email/password sign-up API) once your accounts exist. OAuth sign-in still
# creates users on first login — who may authenticate is the provider's call.
# DISABLE_SIGNUP=true

# Set to true to remove email/password sign-in entirely, leaving OAuth as the
# only way in. Ignored (with a warning in the log) unless at least one OAuth
# provider is configured, so it can't lock you out.
# DISABLE_PASSWORD_LOGIN=true

# First admin: the account with this email becomes "admin" (at sign-up, or on
# the next settings page load while no admin exists). Without it, the first
# account ever created becomes admin.
# INITIAL_ADMIN_EMAIL=you@example.com

# IP(s)/CIDR(s) of your reverse proxy, comma-separated, so sign-in rate
# limiting keys on the real client IP. Not needed without a proxy.
# TRUSTED_PROXY_CIDRS=172.18.0.0/16

# --- OAuth2 sign-in (all optional; each shows a button on /sign-in) ---

# Generic OpenID Connect (Authentik, Keycloak, Authelia, Zitadel, …).
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/oidc
# The issuer must serve /.well-known/openid-configuration.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Authentik

# GitHub. Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google. Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- MCP server (AI assistants) ---

# Serves the inventory to Claude, ChatGPT & co. at {BETTER_AUTH_URL}/api/mcp.
# Off by default: it turns this instance into an OAuth authorization server
# whose client-registration endpoint is unauthenticated by design (that is how
# an MCP client bootstraps). BETTER_AUTH_URL must be the public https URL
# (http only on localhost). See docs/mcp.md.
#
#   (unset)                                   no MCP server
#   ENABLE_MCP=true                           read-only: search parts, stock, BOMs
#   ENABLE_MCP=true + ENABLE_MCP_WRITE=true   also create/edit/import/delete
#                                             parts and book stock
#
# Changing ENABLE_MCP_WRITE applies to already-connected assistants on their
# next request; nobody has to reconnect.
# ENABLE_MCP=true
# ENABLE_MCP_WRITE=true

# --- File storage (part images and datasheets) ---

# "s3" (the default — compose.yml runs MinIO) or "filesystem".
# STORAGE_BACKEND=s3

# With STORAGE_BACKEND=filesystem: the directory files are stored in.
# STORAGE_PATH=./data/files

# With STORAGE_BACKEND=s3: any S3-compatible storage (AWS S3, MinIO, Garage, …)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=inventory
S3_FORCE_PATH_STYLE=true
